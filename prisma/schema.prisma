generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  coverImageUrl String?
  googlePlaceId String?
  instagramUrl  String?
  facebookUrl   String?
  createdAt     DateTime    @default(now())
  tips          Tip[]
  admins        AdminUser[]
  pushSubscriptions PushSubscription[]
  storySlides   StorySlide[]
}

enum TipStatus {
  pending
  succeeded
  failed
}

enum PaymentMethod {
  cash
  card
}

model Tip {
  id                    String        @id @default(cuid())
  storeId               String
  amount                Int
  locale                String
  tableLabel            String?
  paymentMethod         PaymentMethod @default(cash)
  status                TipStatus     @default(pending)
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())
  store                 Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  review                Review?
  notificationReads     NotificationRead[]

  @@index([storeId])
}

model Review {
  id                 String   @id @default(cuid())
  tipId              String   @unique
  storeId            String
  rating             Int
  comment            String?
  photoUrls          String[] @default([])
  redirectedToGoogle Boolean  @default(false)
  createdAt          DateTime @default(now())
  tip                Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// A single admin manages every store, so storeId is optional (no longer the
// scoping key — the active store comes from the top-bar switcher). Kept as an
// optional "home" reference.
model AdminUser {
  id                String             @id @default(cuid())
  storeId           String?
  supabaseUserId    String             @unique
  email             String             @unique
  role              String             @default("owner")
  createdAt         DateTime           @default(now())
  store             Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  notificationReads NotificationRead[]

  @@index([storeId])
}

/** Per-store "Our Story" slide on the guest landing (single language). */
model StorySlide {
  id        String   @id @default(cuid())
  storeId   String
  sortOrder Int      @default(0)
  title     String
  body      String
  imageUrl  String?
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// Web Push subscription for an admin device (one per browser/device). A single
// admin manages every store, so a subscription is global by default (storeId
// null) and receives every store's notifications; a set storeId scopes it to one.
model PushSubscription {
  id          String   @id @default(cuid())
  storeId     String?
  adminUserId String?
  endpoint    String   @unique
  p256dh      String
  auth        String
  createdAt   DateTime @default(now())
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId])
}

/** Per-admin "this notification has been read" marker (set when its modal opens). */
model NotificationRead {
  id          String    @id @default(cuid())
  adminUserId String
  tipId       String
  createdAt   DateTime  @default(now())
  admin       AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tip         Tip       @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, tipId])
  @@index([adminUserId])
}

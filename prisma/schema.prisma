generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StoreStatus {
  // Legacy: was used by the retired self-registration/approval flow. New stores
  // are created `active`; the guest page is now gated on `subscriptionStatus`.
  pending
  active
  suspended
  deleted
}

// Store subscription state, mirrored from Stripe by the webhook.
//   none      — never subscribed (guest page not yet live)
//   trialing  — in the 初月無料 trial (guest page live)
//   active    — paying (guest page live)
//   past_due  — payment failed / retrying (guest page live until Stripe cancels)
//   canceled  — subscription ended (guest page closed)
enum SubscriptionStatus {
  none
  trialing
  active
  past_due
  canceled
}

model Store {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  coverImageUrl String?
  googlePlaceId String?
  instagramUrl  String?
  facebookUrl   String?
  // Registration contact details (店舗登録フォーム). Nullable so pre-existing
  // stores stay valid; the registration form requires all but companyName.
  companyName   String?
  contactName   String?
  phone         String?
  // Store contact email. At registration this same address also creates the
  // operator login (see POST /api/admin/stores); afterwards they're independent.
  email         String?
  address       String?
  // When the operator agreed to the 利用規約 (at subscription registration).
  termsAgreedAt DateTime?   @db.Timestamptz(3)
  // active: normal. suspended: guest tip page closed (history kept).
  // deleted: soft-deleted (hidden everywhere) — see deletedAt.
  status        StoreStatus @default(active)
  // Stripe subscription (¥5,000/月・税抜, 初月無料). Set by the webhook once the
  // operator subscribes on /admin/subscription. The guest page goes live only
  // while subscriptionStatus is trialing/active (see @/lib/subscription).
  stripeCustomerId             String?
  stripeSubscriptionId         String?            @unique
  subscriptionStatus           SubscriptionStatus @default(none)
  subscriptionCurrentPeriodEnd DateTime?          @db.Timestamptz(3)
  // Set when soft-deleted; null while live. Rows are never hard-deleted, so
  // tips/reviews/history survive.
  deletedAt     DateTime?   @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  tips          Tip[]
  admins        AdminUser[]
  pushSubscriptions PushSubscription[]
  storySlides   StorySlide[]
  supportThreads SupportThread[]
  announcements  Announcement[]
  payouts       Payout[]
}

/**
 * A manual payout to a store ("月末振込"). The store's outstanding balance is
 * Σ(succeeded tips) − Σ(payouts), all in USD cents (same unit as Tip.amount).
 * Recorded by the platform admin; a future Stripe-Connect payout would write
 * rows here too.
 */
model Payout {
  id               String    @id @default(cuid())
  storeId          String
  // USD cents, matching Tip.amount.
  amount           Int
  // Optional period this payout covers (for the month-end statement).
  periodStart      DateTime? @db.Timestamptz(3)
  periodEnd        DateTime? @db.Timestamptz(3)
  note             String?
  // The AdminUser who recorded it (platform admin).
  createdByAdminId String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

enum TipStatus {
  pending
  succeeded
  failed
}

enum PaymentMethod {
  cash
  card
}

model Tip {
  id                    String        @id @default(cuid())
  storeId               String
  amount                Int
  locale                String
  tableLabel            String?
  paymentMethod         PaymentMethod @default(cash)
  status                TipStatus     @default(pending)
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  store                 Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  review                Review?
  notificationReads     NotificationRead[]

  // History/aggregates filter storeId + status="succeeded" and sort by createdAt.
  // Scoped (operator / selected store) uses the first; the all-stores admin view
  // (no storeId) uses the second.
  @@index([storeId, status, createdAt])
  @@index([status, createdAt])
}

model Review {
  id                 String   @id @default(cuid())
  tipId              String   @unique
  storeId            String
  rating             Int
  comment            String?
  photoUrls          String[] @default([])
  redirectedToGoogle Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  tip                Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)

  // Review lists sort by createdAt within a store (public/private both paginate).
  @@index([storeId, createdAt])
}

// Two roles:
//  - Platform admin (role "admin"/legacy "owner", storeId null): manages every
//    store; the active store comes from the top-bar switcher.
//  - Store operator (role "store_operator", storeId set): manages only that one
//    store (1 account = 1 store); no switcher, scoped to their storeId.
model AdminUser {
  id                String             @id @default(cuid())
  storeId           String?
  supabaseUserId    String             @unique
  email             String             @unique
  role              String             @default("owner")
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  store             Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  notificationReads NotificationRead[]
  announcementReads AnnouncementRead[]

  @@index([storeId])
}

/**
 * Per-store "Our Story" slide on the guest landing. `title` and `body` are
 * locale maps — { en, ja, ko, zh } — so the story shows in each guest's
 * language (see @/lib/story).
 */
model StorySlide {
  id        String   @id @default(cuid())
  storeId   String
  sortOrder Int      @default(0)
  title     Json
  body      Json
  imageUrl  String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// Web Push subscription for an admin device (one per browser/device). A single
// admin manages every store, so a subscription is global by default (storeId
// null) and receives every store's notifications; a set storeId scopes it to one.
model PushSubscription {
  id          String   @id @default(cuid())
  storeId     String?
  adminUserId String?
  endpoint    String   @unique
  p256dh      String
  auth        String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId])
}

/** Per-admin "this notification has been read" marker (set when its modal opens). */
model NotificationRead {
  id          String    @id @default(cuid())
  adminUserId String
  tipId       String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  admin       AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tip         Tip       @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, tipId])
  @@index([adminUserId])
}

enum SupportStatus {
  open
  resolved
}

enum SupportSender {
  operator
  admin
}

/**
 * A support conversation between a store operator and the platform admin
 * ("運営へのお問い合わせ"). Unread flags drive each side's badge: a new message
 * from the operator marks it unread for the admin and vice-versa; opening the
 * thread clears that side's flag.
 */
model SupportThread {
  id            String           @id @default(cuid())
  storeId       String
  subject       String
  status        SupportStatus    @default(open)
  operatorUnread Boolean         @default(false)
  adminUnread   Boolean          @default(true)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages      SupportMessage[]

  // Operator thread list is scoped by store and ordered by most-recent activity.
  @@index([storeId, updatedAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  threadId  String
  sender    SupportSender
  body      String
  imageUrl  String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

enum AnnouncementStatus {
  draft
  published
  deleted
}

/**
 * Platform-admin announcement to stores ("お知らせ"). storeId null = every store;
 * a set storeId targets one store's operator. Read state is per admin user.
 * Only `published` announcements are visible to operators.
 */
model Announcement {
  id          String             @id @default(cuid())
  title       String
  body        String
  storeId     String?
  status      AnnouncementStatus @default(published)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  store       Store?             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reads       AnnouncementRead[]

  @@index([storeId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  adminUserId    String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  admin          AdminUser    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([announcementId, adminUserId])
  @@index([adminUserId])
}

/** Help / FAQ entry — managed by the platform admin, read-only for operators. */
model Faq {
  id        String   @id @default(cuid())
  category  String
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
